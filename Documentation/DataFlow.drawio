        </mxCell>
        <mxCell id="focus-ui" value="&lt;b&gt;FocusUI&lt;/b&gt;&lt;br&gt;RefreshStatus() calls&lt;br&gt;DataReceiverScript.GetStatusText()&lt;br&gt;and reads IsFocused" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
