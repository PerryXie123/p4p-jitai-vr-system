        <mxCell id="title" value="JITAI VR System — Sensor Data Flow" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="840" y="20" width="520" height="40" as="geometry" />
        </mxCell>

        <mxCell id="incoming" value="&lt;b&gt;Incoming sensor data&lt;/b&gt;&lt;br&gt;UDP text payload: { hrv, eyeGaze }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="900" y="100" width="400" height="80" as="geometry" />
        </mxCell>
        <mxCell id="receive" value="&lt;b&gt;DataReceiverScript&lt;/b&gt;&lt;br&gt;StartReceiver() → ReceiveLoop()&lt;br&gt;UdpClient.Receive() + UTF-8 decode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="900" y="250" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="parse" value="&lt;b&gt;DataReceiverScript.ParseSensorFrame()&lt;/b&gt;&lt;br&gt;Split key/value pairs; parse floats using InvariantCulture&lt;br&gt;Returns SensorFrame { hrv, eyeGaze }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="875" y="420" width="450" height="105" as="geometry" />
        </mxCell>
        <mxCell id="state" value="&lt;b&gt;DataReceiverScript synchronized state&lt;/b&gt;&lt;br&gt;Clamp01() → hrvValue, eyeGazeValue, hasReceivedData&lt;br&gt;Values protected by dataLock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="875" y="605" width="450" height="100" as="geometry" />
        </mxCell>

        <mxCell id="orb-input" value="&lt;b&gt;XR gaze interaction&lt;/b&gt;&lt;br&gt;hoverEntered / hoverExited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="120" y="420" width="300" height="75" as="geometry" />
        </mxCell>
        <mxCell id="orb-focus" value="&lt;b&gt;OrbFocus&lt;/b&gt;&lt;br&gt;OnHoverEnter() / OnHoverExit()&lt;br&gt;DataReceiverScript.SetOrbFocus(bool)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="120" y="605" width="300" height="100" as="geometry" />
        </mxCell>

        <mxCell id="focus-decision" value="&lt;b&gt;DataReceiverScript.IsFocused&lt;/b&gt;&lt;br&gt;GetPassingCheckCount() ≥ 2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="950" y="800" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="thresholds" value="&lt;b&gt;Three checks&lt;/b&gt;&lt;br&gt;IsHrvPassing: received &amp;amp;&amp;amp; HRV &amp;lt; hrvThreshold&lt;br&gt;IsEyeGazePassing: received &amp;amp;&amp;amp; eyeGaze &amp;gt; eyeGazeThreshold&lt;br&gt;IsLookingAtOrb: XR hover state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1400" y="805" width="400" height="130" as="geometry" />
        </mxCell>

        <mxCell id="auditory" value="&lt;b&gt;AuditoryTraining : TrainingMode&lt;/b&gt;&lt;br&gt;DataReceiverScript.UpdateConsumers()&lt;br&gt;→ SetFocus(IsFocused)&lt;br&gt;Update() accumulates focusTimer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="50" y="1120" width="360" height="125" as="geometry" />
        </mxCell>
        <mxCell id="visual" value="&lt;b&gt;VisualTraining : TrainingMode&lt;/b&gt;&lt;br&gt;Update() reads DataReceiverScript.IsFocused&lt;br&gt;focusTimer → visibleAnimalCount&lt;br&gt;FadeAnimalsToward()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="550" y="1120" width="360" height="125" as="geometry" />
        </mxCell>
        <mxCell id="feedback" value="&lt;b&gt;FocusFeedbackController&lt;/b&gt;&lt;br&gt;Update() reads DataReceiverScript.IsFocused&lt;br&gt;and TrainingMode.IsTrainingActive&lt;br&gt;Updates feedbackAmount" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
